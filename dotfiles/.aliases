alias devv='cd ~/Dev'


#TMUX
alias tm='tmux'
alias ta='tmux attach -t'
alias tkill='tmux kill-session -t'
alias tl='tmux ls | grep -n "^"'

# attach to the nth session in the list: tn 1
tn() {
  local name
  name="$(tmux ls -F '#{session_name}' | sed -n "${1}p")"
  if [[ -z "$name" ]]; then
    echo "tn: no session #${1}" >&2
    tmux ls >&2
    return 1
  fi
  tmux attach-session -t "$name"
}
alias t1='tn 1'
alias t2='tn 2'
alias t3='tn 3'
alias t4='tn 4'
alias t5='tn 5'
alias t6='tn 6'
alias t7='tn 7'
alias t8='tn 8'
alias t9='tn 9'

# Start a new session with a given name: tnew foo
tnew() { tmux new -s "$1"; }

# SAFE PY3 MIGRATION
alias py='python3'

#VIRTUAL ENVIRONMENT
alias ac='source bin/activate'
alias deac='deactivate'
mkvenv() {
    local env_path="$HOME/Dev/Envs/$1"
    python3 -m venv "$env_path"
    source "$env_path/bin/activate"
}
alias mkv='mkvenv'

# UV
alias uvr='uv run'

# MISC
alias grep='grep --color'
recy() { mkdir -p ~/Recycle && mv "$@" ~/Recycle/; }

# cd with ls
cc ()
{
 if [ -n "$1" ]; then
   builtin cd "$@" && ls -oh
 else
   builtin cd ~ && ls -oh
 fi
}

extract () {
  if [ -f $1 ] ; then
    case $1 in
      *.tar.bz2)   tar xvjf $1    ;;
      *.tar.gz)    tar xvzf $1    ;;
      *.bz2)       bunzip2 $1     ;;
      *.rar)       unrar x $1       ;;
      *.gz)        gunzip $1      ;;
      *.tar)       tar xvf $1     ;;
      *.tbz2)      tar xvjf $1    ;;
      *.tgz)       tar xvzf $1    ;;
      *.zip)       unzip $1       ;;
      *.Z)         uncompress $1  ;;
      *.7z)        7z x $1        ;;
      *)           echo "don't know how to extract '$1'..." ;;
    esac
  else
    echo "'$1' is not a valid file!"
  fi
}


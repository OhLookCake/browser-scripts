# LISTING
alias lo='ls -oh'
alias loh='ls -o'
alias ll='ls -lah'
alias la='ls -ah'
# count entries: `lsl`, `lsl dir`, or `lsl foo/*/*.csv` (counts the matches)
unalias lsl 2>/dev/null
lsl() {
  if [ "$#" -eq 0 ]; then
    ls | wc -l | tr -d ' '
  elif [ "$#" -eq 1 ] && [ -d "$1" ]; then
    ls "$1" | wc -l | tr -d ' '
  else
    ls -d "$@" | wc -l | tr -d ' '
  fi
}

# SUPERSHORT
alias g='grep'
alias q='exit'
alias c='clear'
alias h='history'
alias cs='clear;ls'
alias cls='clear;ls'
alias bd='cd $OLDPWD'
alias rmrf='rm -rf'
alias rmfr='rm -rf'
alias ..='cd ..'
alias ...='cd ..; cd ..' # not the version with '/' to handle cases where you are less than n levels under root
alias ....='cd ..; cd ..; cd ..'
alias .....='cd ..; cd ..; cd ..; cd ..'

# CONFUSING
alias mktar='tar -cvf'
alias untar='tar -xvf'

# FILES
alias zrc='vim ~/.zshrc'
alias brc='vim ~/.bashrc'
alias vrc='vim ~/.vimrc'
